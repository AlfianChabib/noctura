# ==============================================================================
# Noctura E-Commerce - Development Environment (.env.development)
# ==============================================================================
# Loaded automatically by Vite during `vite dev` or `vite build --mode development`.
# Contains non-sensitive defaults for local development and sandbox environments.
# Override sensitive secrets (API keys, DB credentials) in `.env.local` or `.env.development.local`.

# Mode is automatically handled by Vite (MODE=development, DEV=true).
# To override for external tools, set NODE_ENV in your environment.

# App & Auth URLs
BETTER_AUTH_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"

# Midtrans Payment Gateway (Sandbox)
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"
VITE_MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# RajaOngkir Komerce V2 API (Development Endpoint)
RAJAONGKIR_BASE_URL="https://rajaongkir.komerce.id/api/v1/"
