# ==============================================================================
# Noctura E-Commerce - Master Environment Variable Specification (.env.example)
# ==============================================================================
# Copy this file to:
#   - `.env.local` or `.env.development.local` for local development.
#   - `.env.production.local` for testing production build locally.
# In Cloudflare Pages / Workers: add non-sensitive vars to wrangler.jsonc [vars]
# and sensitive secrets via `wrangler secret put <KEY>` or Cloudflare Dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment & App Config
# ------------------------------------------------------------------------------
# Options: development | production | test
NODE_ENV="development"
PORT=3000

# Canonical Public URLs
SERVER_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"
VITE_APP_TITLE="Noctura Fashion Store"

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Direct connection (used for migrations and Drizzle DDL):
DATABASE_URL="postgresql://username:password@localhost:5432/noctura_dev"

# Pooled connection (PgBouncer / Neon transaction pooler for high concurrency):
DATABASE_URL_POOLER="postgresql://username:password@localhost:5432/noctura_dev?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Better Auth (Authentication & RBAC)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32 (Min 32 characters high entropy)
BETTER_AUTH_SECRET="VHqCgjmGI/9Fax/bHNnWvgWCJ3NKObYwSyv8SLLZAns="

# ------------------------------------------------------------------------------
# 4. Midtrans Snap Payment Gateway
# ------------------------------------------------------------------------------
# Toggle Sandbox vs Production: "false" for dev, "true" for prod
MIDTRANS_IS_PRODUCTION="false"

# Midtrans API Keys (Per update 28 Oct 2026: Signature Secret is separate from Server Key)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_SIGNATURE_SECRET_KEY=""

# Client Snap Script URL:
# Sandbox:    https://app.sandbox.midtrans.com/snap/snap.js
# Production: https://app.midtrans.com/snap/snap.js
MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"
VITE_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
VITE_MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# ------------------------------------------------------------------------------
# 5. RajaOngkir Komerce API V2 (Shipping Rates & Tracking)
# ------------------------------------------------------------------------------
# Base URL: https://rajaongkir.komerce.id/api/v1/
RAJAONGKIR_BASE_URL="https://rajaongkir.komerce.id/api/v1/"
RAJAONGKIR_API_KEY="your-komerce-api-key"

# Origin Warehouse Subdistrict ID (Komerce ID for sender location)
RAJAONGKIR_ORIGIN_SUBDISTRICT_ID="5779"

# ------------------------------------------------------------------------------
# 6. Resend Transactional Email API (Fase 5)
# ------------------------------------------------------------------------------
# API Key from Resend Dashboard: https://resend.com/api-keys
RESEND_API_KEY=""

# Webhook signing secret from Resend Webhooks: https://resend.com/webhooks
RESEND_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 7. ImageKit DAM Media Storage (Fase 2)
# ------------------------------------------------------------------------------
# ImageKit developer credentials: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Client-side ImageKit configuration (Prefix VITE_ for frontend asset upload / rendering)
VITE_IMAGEKIT_PUBLIC_KEY=""
VITE_IMAGEKIT_URL_ENDPOINT=""
