# ==============================================================================
# Noctura E-Commerce - Production Environment (.env.production)
# ==============================================================================
# Loaded automatically by Vite during `vite build` or `vite preview`.
# Contains non-sensitive defaults for production deployment.
# Sensitive secrets (DATABASE_URL, BETTER_AUTH_SECRET, Live API Keys) must be
# configured in Cloudflare Dashboard (Secrets/Vars), CI/CD, or `.env.production.local` (local prod test).

# Mode is automatically handled by Vite (MODE=production, PROD=true).
# To override for external tools, set NODE_ENV in your deployment environment.

# App & Auth URLs (Replace with your registered production domain)
BETTER_AUTH_URL="https://noctura.com"
VITE_APP_URL="https://noctura.com"

# Midtrans Payment Gateway (Production Live)
MIDTRANS_IS_PRODUCTION="true"
MIDTRANS_SNAP_URL="https://app.midtrans.com/snap/snap.js"
VITE_MIDTRANS_SNAP_URL="https://app.midtrans.com/snap/snap.js"

# RajaOngkir Komerce V2 API (Live Production Endpoint)
RAJAONGKIR_BASE_URL="https://rajaongkir.komerce.id/api/v1/"
